# Optional: enables plain-language intake and AI contract review.
ANTHROPIC_API_KEY=
# Models (defaults shown)
CW_MODEL=claude-sonnet-5-5
CW_REVIEW_MODEL=claude-opus-5-5
# Demo token per chain. "local" is Hardhat's deterministic first-deploy address.
CW_DEMO_TOKEN_ADDRESS={"local":"0x5FbDB2315678afecb367f032d93F642f64180aa3"}
CW_DEFAULT_CHAIN=local
# JSON list of browser origins allowed to call the API (only needed when the UI is served elsewhere).
CW_ALLOWED_ORIGINS=["http://localhost:5173"]
# Set true only behind a proxy that overwrites X-Forwarded-For (e.g. Render, Fly).
CW_TRUST_PROXY=false
